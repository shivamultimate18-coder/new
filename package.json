{
  "name": "outreach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "user:create": "tsx --env-file-if-exists=.env scripts/create-user.ts",
    "webhooks:register": "tsx --env-file-if-exists=.env --conditions=react-server scripts/register-webhooks.ts",
    "typecheck": "tsc --noEmit",
    "worker": "tsx --env-file-if-exists=.env --conditions=react-server scripts/worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.17",
    "next": "16.4.5",
    "papaparse": "^5.7.0",
    "pg-boss": "^12.38.1",
    "postgres": "^4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
